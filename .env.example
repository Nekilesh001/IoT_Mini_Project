# ==============================================================================
# Smart Factory - Local Environment Configuration (Template)
# Copy to .env for local overrides. NEVER commit actual passwords or secrets.
# ==============================================================================

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/smart_factory

# MQTT Event Bus Configuration (Eclipse Mosquitto)
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_QOS=1
MQTT_TOPIC_PREFIX=factory

# Store-and-Forward Buffer Configuration
BUFFER_DB_PATH=local_buffer.db
BUFFER_MAX_RETRIES=10
BUFFER_INITIAL_RETRY_DELAY_SEC=1.0
BUFFER_MAX_RETRY_DELAY_SEC=30.0
BUFFER_BATCH_SIZE=50
