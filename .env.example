# ==============================================================================
# Smart Factory - Local Environment Configuration (Template)
# Copy to .env for local overrides. NEVER commit actual passwords or secrets.
# ==============================================================================

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/smart_factory

# MQTT Event Bus Configuration (Eclipse Mosquitto)
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_QOS=1
MQTT_TOPIC_PREFIX=factory

# Store-and-Forward Buffer Configuration
BUFFER_DB_PATH=local_buffer.db
BUFFER_MAX_RETRIES=10
BUFFER_INITIAL_RETRY_DELAY_SEC=1.0
BUFFER_MAX_RETRY_DELAY_SEC=30.0
BUFFER_BATCH_SIZE=50

# AWS IoT Scaffolding (Disabled by default for local-first operation)
AWS_ENABLED=false
AWS_IOT_ENDPOINT=
AWS_REGION=us-east-1
AWS_IOT_THING_PREFIX=factory_machine_
AWS_IOT_ROOT_CA_PATH=
AWS_IOT_CERTIFICATE_PATH=
AWS_IOT_PRIVATE_KEY_PATH=

# External Wokwi IoT Device & HiveMQ MQTT Bridge
WOKWI_MQTT_ENABLED=true
WOKWI_MQTT_BROKER=broker.hivemq.com
WOKWI_MQTT_PORT=1883
WOKWI_MQTT_USERNAME=
WOKWI_MQTT_PASSWORD=
WOKWI_MQTT_TELEMETRY_TOPIC=iot/plant/PLANT_01/line/LINE_A/device/IOT-SENSOR-001/telemetry
WOKWI_MQTT_COMMAND_TOPIC=iot/plant/PLANT_01/line/LINE_A/device/IOT-SENSOR-001/commands
WOKWI_MQTT_CLIENT_ID=smart-factory-wokwi-bridge


